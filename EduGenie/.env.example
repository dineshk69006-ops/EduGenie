# Get a Gemini API key from Google AI Studio.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Current stable Gemini model used by this project.
GEMINI_MODEL=gemini-2.5-flash

# false = simplest setup: Gemini handles explanations too.
# true = use the document's LaMini-Flan-T5 local explainer when available.
USE_LOCAL_EXPLAINER=false

# Used only when USE_LOCAL_EXPLAINER=true
LOCAL_EXPLAINER_MODEL=MBZUAI/LaMini-Flan-T5-783M
